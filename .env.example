# ============================================================================
#  Connexion Shopify — Storefront API  (méthode officielle storefront externe)
# ----------------------------------------------------------------------------
#  Copie ce fichier en .env.local pour le dev  ( cp .env.example .env.local )
#  Pour la production (GitHub Pages) : mets ces valeurs dans
#  GitHub → Settings → Secrets and variables → Actions → onglet "Variables".
#
#  ⚠️  Le préfixe NEXT_PUBLIC_ est OBLIGATOIRE : ces valeurs sont lues par le
#      navigateur (export statique). Le jeton Storefront ci-dessous est PUBLIC
#      par conception — il n'autorise QUE des lectures produits et la création
#      de paniers, jamais l'API Admin. Aucun secret Admin ne doit être placé
#      dans ce projet.
# ============================================================================

# Domaine technique de la boutique (PAS le domaine perso). Exemple :
NEXT_PUBLIC_SHOPIFY_DOMAIN=ecomdz-store.myshopify.com

# Jeton d'accès Storefront API (public).
# Admin Shopify → Paramètres → Applications et canaux de vente →
#   Développer des apps → [ton app] → API Storefront → "Storefront API access token"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Handle du produit (ce qui suit /products/ dans l'URL). Exemple : "offre" ou "mcquenne"
NEXT_PUBLIC_SHOPIFY_PRODUCT_HANDLE=offre

# (Optionnel) Si tu as 3 produits Shopify séparés, un par coloris.
# Laisse vide pour utiliser NEXT_PUBLIC_SHOPIFY_PRODUCT_HANDLE pour les trois.
NEXT_PUBLIC_SHOPIFY_HANDLE_NAVY=
NEXT_PUBLIC_SHOPIFY_HANDLE_WHITE=
NEXT_PUBLIC_SHOPIFY_HANDLE_BLACK=

# Version de l'API Storefront (laisse tel quel sauf raison précise)
NEXT_PUBLIC_SHOPIFY_API_VERSION=2024-10
