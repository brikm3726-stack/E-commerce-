<section class="section page-width">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem">
    <h1>{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}" class="button button--ghost">{{ 'customer.account.logout' | t }}</a>
  </div>
  <h2 style="margin-top:2rem">{{ 'customer.account.orders' | t }}</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table style="width:100%;margin-top:1rem;border-collapse:collapse">
        <thead><tr><th style="text-align:left">Commande</th><th style="text-align:left">Date</th><th style="text-align:left">Total</th><th></th></tr></thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr style="border-top:1px solid var(--color-line)">
              <td>{{ order.name }}</td><td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
              <td>{{ order.total_price | money }}</td>
              <td><a href="{{ order.customer_url }}" class="link-underline">Voir</a></td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p>Aucune commande pour le moment.</p>
    {%- endif -%}
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}

  <h2 style="margin-top:2rem">Adresse</h2>
  <p>{{ customer.default_address | format_address }}</p>
  <a href="{{ routes.account_addresses_url }}" class="button button--secondary" style="margin-top:1rem">Gerer les adresses</a>
</section>
