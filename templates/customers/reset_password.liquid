<section class="section page-width" style="max-width:26rem">
  <h1>Nouveau mot de passe</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label for="rp1">Mot de passe</label><input type="password" name="customer[password]" id="rp1" required>
    <label for="rp2" style="margin-top:1rem">Confirmation</label><input type="password" name="customer[password_confirmation]" id="rp2" required>
    <button type="submit" class="button" style="width:100%;margin-top:1.25rem">Valider</button>
  {%- endform -%}
</section>
