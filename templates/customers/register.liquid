<section class="section page-width" style="max-width:26rem">
  <h1>{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <label for="rf">Prenom</label><input type="text" name="customer[first_name]" id="rf">
    <label for="rl" style="margin-top:1rem">Nom</label><input type="text" name="customer[last_name]" id="rl">
    <label for="re" style="margin-top:1rem">E-mail</label><input type="email" name="customer[email]" id="re" required>
    <label for="rp" style="margin-top:1rem">Mot de passe</label><input type="password" name="customer[password]" id="rp" required>
    <button type="submit" class="button" style="width:100%;margin-top:1.25rem">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
  <p style="margin-top:1rem"><a href="{{ routes.account_login_url }}" class="link-underline">{{ 'customer.login_page.sign_in' | t }}</a></p>
</section>
