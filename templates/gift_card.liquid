{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} — {{ gift_card.balance | money }}</title>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <style>body{display:grid;place-content:center;min-height:100vh;text-align:center;padding:2rem}</style>
  </head>
  <body>
    <main class="page-width" style="max-width:26rem">
      <div class="header__logo" style="font-size:1.5rem">{{ shop.name }}</div>
      <p class="eyebrow" style="margin-top:1rem">Carte cadeau</p>
      <h1 style="margin-top:.25rem">{{ gift_card.balance | money }}</h1>
      {%- if gift_card.balance != gift_card.initial_value -%}
        <p style="color:var(--color-fg-3)">Solde initial : {{ gift_card.initial_value | money }}</p>
      {%- endif -%}

      <div class="surface" style="padding:1.5rem;margin:1.5rem 0">
        <p style="font-size:.8rem;color:var(--color-fg-3)">Code</p>
        <p style="font-family:monospace;letter-spacing:.15em;font-size:1.1rem;margin-top:.35rem">{{ gift_card.code | format_code }}</p>
      </div>

      {%- if gift_card.expired -%}
        <p class="badge badge--danger">Carte expirée</p>
      {%- else -%}
        <a href="{{ shop.url }}" class="button">Utiliser en boutique</a>
      {%- endif -%}
    </main>
  </body>
</html>
