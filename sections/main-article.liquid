<section class="section page-width">
  <article class="rich-text" style="text-align:left;max-width:46rem">
    <p class="eyebrow">{{ article.published_at | date: '%d %B %Y' }}</p>
    <h1>{{ article.title }}</h1>
    {%- if article.image -%}
      <div style="margin:1.5rem 0">{{ article.image | image_url: width: 1400 | image_tag: alt: article.title | escape }}</div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p style="margin-top:2rem"><a href="{{ blog.url }}" class="button button--ghost">{{ 'blogs.article.back_to_blog' | t }}</a></p>
  </article>

  {%- if blog.comments_enabled? -%}
    <div class="page-width" style="max-width:46rem;margin-top:2rem">
      {%- if article.comments_count > 0 -%}
        {%- for comment in article.comments -%}
          <div class="surface" style="padding:1rem;margin-bottom:1rem">
            <strong>{{ comment.author }}</strong>
            <p>{{ comment.content }}</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
      {%- form 'new_comment', article -%}
        <h3>Laisser un commentaire</h3>
        <div style="display:grid;gap:.75rem;margin-top:.75rem">
          <input type="text" name="comment[author]" placeholder="Nom" required>
          <input type="email" name="comment[email]" placeholder="E-mail" required>
          <textarea name="comment[body]" rows="4" placeholder="Message" required></textarea>
          <button type="submit" class="button">Envoyer</button>
        </div>
      {%- endform -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
