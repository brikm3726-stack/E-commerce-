<section class="section page-width" style="max-width:34rem">
  <h1>{{ section.settings.heading | default: page.title }}</h1>
  {%- if page.content != blank -%}<div class="rte" style="margin:1rem 0">{{ page.content }}</div>{%- endif -%}
  {%- form 'contact' -%}
    {%- if form.posted_successfully? -%}
      <p class="badge badge--success">{{ section.settings.success | default: 'Message envoye, merci.' }}</p>
    {%- endif -%}
    {{ form.errors | default_errors }}
    <label for="cn">Nom</label><input type="text" name="contact[name]" id="cn" required>
    <label for="ce" style="margin-top:1rem">E-mail</label><input type="email" name="contact[email]" id="ce" required>
    <label for="cp" style="margin-top:1rem">Telephone</label><input type="tel" name="contact[phone]" id="cp">
    <label for="cb" style="margin-top:1rem">Message</label><textarea name="contact[body]" id="cb" rows="5" required></textarea>
    <button type="submit" class="button" style="margin-top:1.25rem;width:100%">Envoyer</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Formulaire de contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Contact" },
    { "type": "text", "id": "success", "label": "Message de confirmation", "default": "Message envoye, merci." }
  ]
}
{% endschema %}
