<section class="section page-width">
  {%- if section.settings.heading != blank -%}
    <div class="section-header reveal"><h2>{{ section.settings.heading }}</h2></div>
  {%- endif -%}
  <div class="cat-grid">
    {%- assign collections_to_show = section.settings.collections_count -%}
    {%- for collection in collections limit: collections_to_show -%}
      <a href="{{ collection.url }}" class="cat-card reveal">
        {%- if collection.featured_image -%}
          {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title | escape }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
        <span class="cat-card__label">{{ collection.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Toutes les collections" },
    { "type": "range", "id": "collections_count", "min": 3, "max": 24, "step": 1, "label": "Nombre de collections", "default": 12 }
  ],
  "presets": [{ "name": "t:sections.collection_list.name" }]
}
{% endschema %}
