<section class="section page-width">
  {%- if section.settings.heading != blank -%}
    <div class="section-header reveal">
      <p class="eyebrow">{{ section.settings.subheading }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}
  <div class="cat-grid">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <a href="{{ col.url | default: block.settings.link }}" class="cat-card reveal" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title | escape }}
        {%- elsif col.featured_image != blank -%}
          {{ col.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: col.title | escape }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
        <span class="cat-card__label">{{ block.settings.title | default: col.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.category_grid.name",
  "settings": [
    { "type": "text", "id": "subheading", "label": "t:sections.hero.subheading", "default": "Explorer" },
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Nos catégories" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.category_grid.collection" },
        { "type": "text", "id": "title", "label": "t:sections.all.heading" },
        { "type": "image_picker", "id": "image", "label": "t:sections.all.image" },
        { "type": "url", "id": "link", "label": "t:sections.all.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.category_grid.name",
      "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }]
    }
  ]
}
{% endschema %}
