<section class="section page-width">
  <div class="newsletter reveal">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subtext != blank -%}<p style="color:var(--color-fg-2);margin-top:.5rem">{{ section.settings.subtext }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="badge badge--success" style="margin-top:1rem">{{ 'general.newsletter_form.confirmation' | t }}</p>
      {%- else -%}
        <div style="display:flex;gap:.5rem;margin-top:1.25rem">
          <input type="email" name="contact[email]" required placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" aria-label="Email">
          <button type="submit" class="button">{{ 'general.newsletter_form.button_label' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Rejoignez EcomDZ" },
    { "type": "text", "id": "subtext", "label": "t:sections.all.content", "default": "Nouveautés et meilleures offres, une fois par semaine." }
  ],
  "presets": [{ "name": "t:sections.newsletter.name" }]
}
{% endschema %}
