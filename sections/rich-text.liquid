<section class="section page-width">
  <div class="rich-text reveal">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}<p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- when 'heading' -%}<h2 {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}<div {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}<p {{ block.shopify_attributes }} style="margin-top:1.5rem"><a href="{{ block.settings.link }}" class="button">{{ block.settings.label }}</a></p>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "blocks": [
    { "type": "eyebrow", "name": "Sur-titre", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "t:sections.all.content", "default": "À propos" }] },
    { "type": "heading", "name": "Titre", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "t:sections.all.heading", "default": "Une paire à la fois" }] },
    { "type": "text", "name": "Texte", "settings": [{ "type": "richtext", "id": "text", "label": "t:sections.all.content", "default": "<p>Chaque produit est sélectionné à l'unité, contrôlé, puis mis en ligne. Pas de surstock, pas de promesse en l'air.</p>" }] },
    { "type": "button", "name": "Bouton", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "t:sections.all.link_label", "default": "En savoir plus" },
      { "type": "url", "id": "link", "label": "t:sections.all.link" }
    ] }
  ],
  "presets": [{ "name": "t:sections.rich_text.name", "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }] }]
}
{% endschema %}
