<footer class="footer">
  <div class="page-width footer__inner">
    <div>
      <div class="header__logo" style="font-size:1.4rem">
        {%- if settings.logo != blank -%}{{ settings.logo | image_url: width: 240 | image_tag: alt: shop.name }}{%- else -%}{{ shop.name }}{%- endif -%}
      </div>
      {%- if section.settings.tagline != blank -%}<p style="color:var(--color-fg-2);margin-top:.75rem;max-width:28rem">{{ section.settings.tagline }}</p>{%- endif -%}
      {%- if section.settings.show_social -%}
        <div class="footer__social">
          {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" class="header__icon" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" class="header__icon" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" class="header__icon" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
          {%- if settings.whatsapp != blank -%}<a href="https://wa.me/{{ settings.whatsapp }}" class="header__icon" aria-label="WhatsApp">{% render 'icon', name: 'whatsapp' %}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu' -%}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading | default: linklists[block.settings.menu].title }}</h3>
          {%- for link in linklists[block.settings.menu].links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      {%- elsif block.type == 'text' -%}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading }}</h3>
          <div style="color:var(--color-fg-2);font-size:.9rem">{{ block.settings.content }}</div>
          {%- if settings.phone != blank -%}<a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.payment_text != blank -%}
    <div class="footer__bottom">{{ section.settings.payment_text }}</div>
  {%- endif -%}
  <div class="footer__bottom">© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright }}</div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Slogan", "default": "Le shopping qui vous ressemble" },
    { "type": "checkbox", "id": "show_social", "label": "t:sections.footer.show_social", "default": true },
    { "type": "text", "id": "payment_text", "label": "t:sections.footer.payment_text", "default": "Paiement à la livraison • Livraison 48–72 h partout en Algérie" },
    { "type": "text", "id": "copyright", "label": "Mention légale", "default": "Tous droits réservés." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.all.heading" },
        { "type": "link_list", "id": "menu", "label": "t:sections.header.menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Texte / contact",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Contact" },
        { "type": "richtext", "id": "content", "label": "t:sections.all.content" }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "menu" },
      { "type": "text" }
    ]
  }
}
{% endschema %}
