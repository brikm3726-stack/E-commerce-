<section class="section page-width" style="min-height:80vh;display:grid;place-content:center;text-align:center;max-width:34rem">
  <div class="header__logo" style="font-size:2rem;justify-self:center">
    {%- if settings.logo != blank -%}{{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name }}{%- else -%}{{ shop.name }}{%- endif -%}
  </div>
  <h1 style="margin-top:1rem">{{ section.settings.heading | default: 'Bientôt de retour' }}</h1>
  {%- if section.settings.text != blank -%}<p style="color:var(--color-fg-2);margin:1rem 0">{{ section.settings.text }}</p>{%- endif -%}

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}<p class="badge badge--danger">{{ form.errors.messages.form }}</p>{%- endif -%}
    <div style="display:flex;gap:.5rem;margin-top:1rem">
      <input type="password" name="password" placeholder="Mot de passe" aria-label="Mot de passe" required>
      <button type="submit" class="button">Entrer</button>
    </div>
  {%- endform -%}

  <p style="margin-top:2rem;font-size:.85rem;color:var(--color-fg-3)">Propulsé par Shopify</p>
</section>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.all.heading", "default": "Bientôt de retour" },
    { "type": "textarea", "id": "text", "label": "t:sections.all.content", "default": "Notre boutique ouvre très prochainement." }
  ]
}
{% endschema %}
